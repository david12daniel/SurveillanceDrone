# GitHub Repo
# ======================
# Exclude OpenClaw workspace and temporary files.

# Local memory, logs, and caches
memory/
*.log

# ArduPilot SITL run artifacts (dataflash logs, EEPROM param dump, terrain cache)
logs/
eeprom.bin
terrain/

# Python compiled files
*.pyc
__pycache__/

# System files
.DS_Store

# IDE specific
.vscode/
.idea/
*.sublime-

# ArduPilot SITL runtime artifacts (regenerated by every run; the binary
# itself, eeprom.bin, flight logs, terrain cache -- see analysis/sitl_tests/)
eeprom.bin
/logs/
/terrain/
/state/
analysis/sitl_tests/bin/
analysis/sitl_tests/eeprom.bin
analysis/sitl_tests/logs/
analysis/sitl_tests/terrain/

# OpenClaw agent runtime/session state (machine-local, not project content --
# churns every run, was never meant to be tracked; see git history for the
# untrack commit that cleaned this up)
sessions/
agent/auth-profiles.json
agent/auth-state.json
.openclaw/tmp/

# Same category as above, different filenames that slipped through the
# existing rules: sqlite-import backups of the auth files, the agent's live
# session database (plus its -shm/-wal companions), and the workspace state
# dump. All machine-local runtime state, not project content.
agent/*.bak
agent/openclaw-agent.sqlite*
openclaw-workspace-state.json

# OpenClaw's own model-provider catalog -- rewritten by OpenClaw itself
# between sessions (provider list, pricing), not project content. Same
# category as the runtime state untracked in 0e4be23; models.json and
# plugins/ just slipped through that cleanup.
agent/models.json
agent/plugins/

# Bootstrap training dataset (task D1.2) -- multi-GB of images, does not
# belong in git. See D1_2_BOOTSTRAP_COMPLETE.md for the writeup instead.
datasets/

# Transient edit backups
*.bak
